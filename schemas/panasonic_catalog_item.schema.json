{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://topinstal.local/schemas/panasonic_catalog_item.schema.json",
  "title": "Panasonic Catalog Item",
  "type": "object",
  "required": [
    "source_doc",
    "source_vendor",
    "source_brand",
    "source_effective_date",
    "page",
    "section",
    "category",
    "product_name",
    "model",
    "currency",
    "extraction_confidence",
    "source_text_fragment"
  ],
  "properties": {
    "id": { "type": "string" },
    "source_doc": { "type": "string" },
    "source_vendor": { "type": "string" },
    "source_brand": { "type": "string" },
    "source_effective_date": { "type": "string" },
    "page": { "type": "integer", "minimum": 1 },
    "section": { "type": "string" },
    "subsection": { "type": "string" },
    "category": {
      "type": "string",
      "enum": [
        "heat_pumps",
        "tanks",
        "buffers",
        "dhw_heat_pumps",
        "controllers_thermostats",
        "sensors_expansion_boards",
        "hydraulic_accessories",
        "communication_modules",
        "other_accessories",
        "ventilation",
        "fan_coils"
      ]
    },
    "subcategory": { "type": "string" },
    "product_family": { "type": "string" },
    "series": { "type": "string" },
    "generation": { "type": "string" },
    "product_name": { "type": "string" },
    "model": { "type": "string" },
    "sku_or_catalog_code": { "type": "string" },
    "description_short": { "type": "string" },
    "phase": { "type": "string" },
    "refrigerant": { "type": "string" },
    "unit_type": { "type": "string" },
    "indoor_unit": { "type": "string" },
    "outdoor_unit": { "type": "string" },
    "tank_volume_l": { "type": ["number", "null"] },
    "buffer_volume_l": { "type": ["number", "null"] },
    "heater_kw": { "type": ["number", "null"] },
    "power_kw": { "type": ["number", "null"] },
    "price_net": { "type": ["number", "null"] },
    "bundle_price_net": { "type": ["number", "null"] },
    "currency": { "type": "string" },
    "includes_wifi": { "type": "boolean" },
    "notes": { "type": "string" },
    "extraction_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "uncertainty_notes": { "type": "string" },
    "source_text_fragment": { "type": "string" },
    "category_specific": { "type": "object" }
  },
  "additionalProperties": true
}
