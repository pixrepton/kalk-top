{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://topinstal.local/schemas/offer-document-request-dto.v1.json",
  "title": "OfferDocumentRequestDTO",
  "description": "Request for document generation. Producer: kalk-top, RAG adapter. Consumer: top-instal-generator.",
  "type": "object",
  "required": ["schemaVersion"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "1.0" },
    "traceId": { "type": "string" },
    "mode": { "type": "string", "enum": ["direct-config", "from-offer-dto"] },
    "documentType": { "type": "string" },
    "outputFormat": { "type": "string", "enum": ["pdf", "docx"] },
    "payload": { "type": "object" },
    "offerDto": { "type": "object" },
    "context": { "type": "object" }
  },
  "additionalProperties": true
}
